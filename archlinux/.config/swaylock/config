# ==========================================
# swaylock-effects
# Niri / Catppuccin Mocha / Mauve
# ==========================================

# Background
screenshots
effect-blur=12x6
effect-vignette=0.35:0.35
fade-in=0.25

# Clock
clock
timestr=%H:%M
datestr=%Y-%m-%d

# Font
font=JetBrainsMono Nerd Font
font-size=50

# Indicator
indicator
indicator-radius=140
indicator-thickness=10
indicator-idle-visible

# Behavior
ignore-empty-password
show-failed-attempts

# Colors
text-color=cdd6f4
inside-color=1e1e2ecc
line-color=00000000
separator-color=00000000

# Normal ring
ring-color=cba6f7
key-hl-color=b4befe

# Clear state
inside-clear-color=313244cc
ring-clear-color=89b4fa
text-clear-color=cdd6f4

# Verifying state
inside-ver-color=313244cc
ring-ver-color=cba6f7
text-ver-color=cdd6f4

# Wrong password
inside-wrong-color=313244ee
ring-wrong-color=f38ba8
text-wrong-color=f38ba8
